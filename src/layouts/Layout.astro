---
import '../styles/site.css';

interface Props {
	title?: string;
	description?: string;
	path?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	structuredData?: unknown;
}

const {
	title = 'Foldnote | Visual Notes for Shared Life',
	description = 'Create notes with blocks, stickers, folders, and shared spaces in a warm, flexible editor built for everyday life.',
	path = '/',
	image = '/og-foldnote.png',
	imageAlt = 'Foldnote preview card with warm paper styling and visual note-taking interface',
	noindex = false,
	structuredData
} = Astro.props;

const site = 'https://foldnote.app';
const canonical = new URL(path, site).toString();
const absoluteImage = new URL(image, site).toString();
const imageType = image.endsWith('.png')
	? 'image/png'
	: image.endsWith('.svg')
		? 'image/svg+xml'
		: undefined;
const robots = noindex
	? 'noindex, nofollow'
	: 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<meta name="application-name" content="Foldnote" />
		<meta name="apple-mobile-web-app-title" content="Foldnote" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="apple-itunes-app" content="app-id=6761731923" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Foldnote" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={absoluteImage} />
		{imageType && <meta property="og:image:type" content={imageType} />}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImage} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<meta name="theme-color" content="#f7efe3" />
		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
		{googleSiteVerification && (
			<meta name="google-site-verification" content={googleSiteVerification} />
		)}
		{bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
